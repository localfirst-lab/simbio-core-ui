{
  "_comment": "Configuration Template for VPS Monitor & Autonomous Security Shield",
  "_instructions": "Copy this file to config_monitor.json and fill in your private server details",

  "vps": {
    "host": "<YOUR_VPS_IP_OR_DOMAIN>",
    "user": "root",
    "ssh_key": "<PATH_TO_YOUR_PRIVATE_KEY>",
    "port": 22
  },

  "whitelist_ips": [
    "127.0.0.1",
    "::1",
    "<YOUR_CLIENT_IP_HERE>"
  ],

  "expected_open_ports": [22, 53, 80, 443, 8000, 8550, 11434],
  "port_notes": {
    "22": "SSH",
    "53": "DNS resolver",
    "80": "HTTP Web",
    "443": "HTTPS SSL",
    "8000": "FastAPI Core Gateway",
    "11434": "Ollama Local Engine"
  },

  "alerts": {
    "telegram": {
      "enabled": true,
      "bot_token": "<YOUR_TELEGRAM_BOT_TOKEN>",
      "chat_id": "<YOUR_TELEGRAM_CHAT_ID>",
      "admin_chat_id": "<YOUR_ADMIN_CHAT_ID>"
    },
    "thresholds": {
      "max_failed_logins_per_hour": 5,
      "max_invalid_user_logins": 3,
      "max_new_open_ports": 1,
      "alert_on_root_login": true,
      "alert_on_unknown_ip": true
    }
  },

  "blocking": {
    "enabled": true,
    "method": "iptables",
    "ban_duration_hours": 48,
    "banned_file": "/var/log/vps_monitor/banned_ips.json"
  },

  "monitor": {
    "cycle_interval_seconds": 60,
    "log_file": "/var/log/vps_monitor/monitor.log",
    "auth_log": "/var/log/auth.log",
    "report_lines": 300
  }
}
