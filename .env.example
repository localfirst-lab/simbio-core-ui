# ==============================================================================
# Simbio Core API & UI - Environment Configuration
# ==============================================================================
# Generate a secure 32-byte hexadecimal secret:
#   openssl rand -hex 32
# or with Python:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ==============================================================================

# Core API Security Key (Required)
SIMBIO_API_KEY=<YOUR_SECURE_API_KEY_HERE>

# Network Bind Configuration
HOST=0.0.0.0
PORT=8000

# Local Ollama Daemon Endpoint on VPS (Internal loopback recommended)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default Model Selection (e.g., qwen2.5:14b, mistral:7b, gemma2:9b)
DEFAULT_MODEL=qwen2.5:14b

# CORS Configuration (Comma-separated origins, or * for universal access)
ALLOWED_ORIGINS=*

# Optional Telegram External Sovereign Ledger Integration
# Bot Token from @BotFather:
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
# Target Channel or Chat ID (e.g. -100xxxxxxxxxx):
TELEGRAM_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>

# Server Name Identifier for Alerts (e.g. VPS-Frankfurt or Hostname)
SERVER_NAME=<YOUR_SERVER_NAME_OR_IP>

# Protected Whitelist IP Addresses for Firewall Immunity (comma-separated)
SECURITY_WHITELIST_IPS=127.0.0.1,::1,<YOUR_HOME_IP_HERE>
